index b9d191a..0794416 100644
--- a/nan.h
+++ b/nan.h
@@ -22,6 +22,35 @@
 #define NAN_H_
 
 #include <node_version.h>
+// V8 14.0+ compat: AccessControl was removed in V8 14
+// Tags (kExternalPointerTypeTagDefault/kEmbedderDataTypeTagDefault):
+//   - V8 13+ in Node.js fork: REMOVED. Use simple API (no tag).
+//   - V8 14 (Electron): still PRESENT. Use tag API.
+// We use NODE_MODULE_VERSION as the discriminator:
+//   NMV >= 142 (Electron): tags required
+//   NMV < 142 (Node.js 24+): no tags
+#ifdef __has_include
+#if __has_include(<v8-version.h>)
+#include <v8-version.h>
+#endif
+#endif
+#if defined(V8_MAJOR_VERSION) && (V8_MAJOR_VERSION > 13)
+#define NAN_ACCESS_CONTROL_PARAM
+#define NAN_ACCESS_CONTROL_PARAM_WITH_DEFAULT
+#else
+#define NAN_ACCESS_CONTROL_PARAM , v8::AccessControl settings
+#define NAN_ACCESS_CONTROL_PARAM_WITH_DEFAULT , v8::AccessControl settings = v8::DEFAULT
+#endif
+#if NODE_MODULE_VERSION >= 142
+#define NAN_EXTERNAL_TAG v8::kExternalPointerTypeTagDefault
+#define NAN_EXTERNAL_TAG_COMMA , v8::kExternalPointerTypeTagDefault
+#define NAN_EMBEDDER_TAG_COMMA , v8::kEmbedderDataTypeTagDefault
+#else
+#define NAN_EXTERNAL_TAG
+#define NAN_EXTERNAL_TAG_COMMA
+#define NAN_EMBEDDER_TAG_COMMA
+#endif
+
 
 #define NODE_0_10_MODULE_VERSION 11
 #define NODE_0_12_MODULE_VERSION 14
