 class ComInit {
    public:
-    ComInit() { CoInitializeEx(0, COINIT_MULTITHREADED); }
+    ComInit() {
+        // 记录 CoInitializeEx 的返回值：S_OK / S_FALSE 表示当前线程已完成 COM 初始化，
+        // 析构时必须用 CoUninitialize 配对；RPC_E_CHANGED_MODE 表示该线程已被其它代码
+        // （如 Electron/Chromium 主进程）以不同模式初始化，此时绝不能调用 CoUninitialize，
+        // 否则会错误释放调用方的 COM 引用计数，破坏线程 COM 状态，进而触发后续
+        // "Must be called on Chrome_UIThread" 断言崩溃（这是崩溃的根因之一）
+        m_hr = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+        m_initialized = SUCCEEDED(m_hr);
+    }
 
-    ~ComInit() { CoUninitialize(); }
+    ~ComInit() {
+        if (m_initialized) {
+            CoUninitialize();
+        }
+    }
 
    private:
     ComInit(const ComInit &);
     ComInit &operator=(const ComInit &);
+
+    HRESULT m_hr = E_FAIL;
+    bool m_initialized = false;
 };
 
