      "banned_lemmas_source": "R-G2-03 动词/副词禁用黑名单（v0.7.0 修订，2026-10-04 用户裁决）：pos ∈ {v,r} 默认准入，仅命中本表才拒。原设计为「白名单豁免后可标注」，但白名单实际为空 → 实测硬拦全部 8,628 条 v/r 概念（占 59,433 行的 14.5%，含「微笑/拍摄/阅读/烹饪」等现实标签），故改为默认准入 + 黑名单。缺省为空 = 不拦任何 v/r；严禁在代码中内置副本。",
      "closed_pos_source": "R-G2-04 闭类词性拒绝（m数词/q量词/p介词/c连词/u助词/y代词/o拟声词/h疑问词）。",
      "cleaned_pos_source": "R-G2-05 构建期清洗词性拒绝（w标点/g字母前缀/b单字）。",
      "banned_sememe_source": "R-G2-06 语义要素含 FuncWord|功能词 或 punc|标点 即拒（HowNet 义原）。",
      "dimension_source": "R-G2-07 source = 'dimension' 或命中受控维度根即拒（PRD-0051 受控维度与标签互斥律）。",
      "banned_lexfile_source": "R-G2-08 adv.all 与 adj.pert 词类域即拒（PWN/OMW 关系形容词与全量副词剪枝）。"
    }
