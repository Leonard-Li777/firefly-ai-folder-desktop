{
  "compilerOptions": {
    "target": "ESNext",
    "module": "es2022",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "allowSyntheticDefaultImports": true,
    "types": ["node", "react", "react-dom", "electron"],
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/*"],
      "@src/*": ["src/*"],
      "@lib/*": ["src/renderer/lib/*"],
      "@renderer/*": ["src/renderer/*"],
      "@hooks/*": ["src/renderer/hooks/*"],
      "@shared/*": ["src/shared/*"],
      "@types/*": ["src/types/*"],
      "@type": ["src/types"],
      "@type/*": ["src/types/*"],
      "@runtime": ["src/electron/runtime-services"],
      "@runtime/*": ["src/electron/runtime-services/*"],
      "@components/*": ["src/renderer/components/*"],
      "@stores/*": ["src/renderer/stores/*"],
      "@assets/*": ["src/renderer/assets/*"],
      "@firefly/core-engine": ["pro/packages/core-engine/src"],
      "@firefly/core-engine/*": ["pro/packages/core-engine/src/*"],
      "@firefly/electron-llamaIndex-service": ["pro/packages/electron-llamaIndex-service/src"],
      "@firefly/electron-llamaIndex-service/*": [
        "pro/packages/electron-llamaIndex-service/src/*"
      ],
      "@firefly/types": ["pro/packages/types/src"],
      "@firefly/types/*": ["pro/packages/types/src/*"],
      "@firefly/shared": ["pro/packages/shared/src"],
      "@firefly/shared/*": ["pro/packages/shared/src/*"],
      "@firefly/shared/languages": ["pro/packages/shared/languages"],
      "@firefly/server": ["pro/packages/server/src"],
      "@firefly/server/*": ["pro/packages/server/src/*"],
      "@pro": ["pro/src/index.ts", "src/shared/pro-stub/index.ts"],
      "@pro/*": ["pro/src/*", "src/shared/pro-stub/*"]
    }
  },
  "include": [
    "src/global.d.ts",
    "src/shared/types/electron-api.d.ts",
    "src/**/*",
    "src/**/*.json",
    "pro/src/**/*",
    "*.d.ts",
    "src/shared/types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    ".vite",
    "src/electron/runtime-services/examples/**/*",
    "src/electron/tools/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "pro/packages/**/__tests__/**/*"
  ]
}
